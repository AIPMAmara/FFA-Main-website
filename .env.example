# Copy this file to .env.local for local testing and fill in the blanks.
# .env.local is git-ignored — never commit real keys. In production, set these
# in Vercel → Project → Settings → Environment Variables instead (without the quotes).

# Resend API key with FULL access (starts with re_). A "sending access" key
# can't save newsletter subscribers.
RESEND_API_KEY=

# Sender for all website emails — must be on the domain verified in Resend.
EMAIL_FROM="FemmeFluence Africa <hello@femmefluenceafrica.org>"

# Inbox that receives contact-form enquiries (comma-separate for several).
# Also where replies to the newsletter welcome email go.
# Until the hello@ inbox exists, put your own address here for local testing.
CONTACT_TO_EMAIL=hello@femmefluenceafrica.org

# ID of the "Newsletter" segment: Resend → Audience → Segments → create one, copy its ID.
NEWSLETTER_SEGMENT_ID=
